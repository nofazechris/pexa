# PrivyPay environment configuration (§121).
# Copy to .env.local and fill in. .env* is gitignored — never commit real secrets (§83).
# Every value is optional at Stage 0; each is required by the stage that introduces it.

# --- Runtime ---
APP_ENV=local                      # local | development | staging | production
NEXT_PUBLIC_SITE_URL=              # public origin for social/SEO metadata (e.g. https://privypay.app)

# --- Database (Foundation / §33) — Supabase Postgres ---
DATABASE_URL=

# --- Auth session (Stage 3 / §8) ---
AUTH_SECRET=

# --- AI agent (Stage 9 / §24) — OpenAI, behind the agent provider abstraction ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# --- Wallet provider (Stage 5 / §11–12) — Privy embedded wallets ---
WALLET_PROVIDER=privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Celo settlement (Stage 6 / §13–15) ---
CELO_NETWORK=sepolia               # sepolia (testnet) | mainnet
CELO_RPC_URL=                      # mainnet RPC (provider with SLA in production)
CELO_SEPOLIA_RPC_URL=              # testnet RPC
CELO_USDC_ADDRESS=                 # verify against an official source before enabling (§15)

# --- Integrations (Stages 14–17) ---
MCP_SECRET=
WHATSAPP_WEBHOOK_SECRET=
